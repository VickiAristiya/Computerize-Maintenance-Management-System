# Salin file ini jadi ".env" (di folder cmms-backend yang sama) lalu isi sesuai
# environment masing-masing. ".env" TIDAK ikut ke git (lih. .gitignore) — jadi
# aman menyimpan kredensial di sana, dan setiap environment (dev lokal, VM
# production) boleh punya isi berbeda tanpa pernah bentrok saat `git pull`.

# --- Keamanan ---
# Wajib diganti dengan string acak panjang di production. Generate contoh:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=random_string_panjang_disini

# Aktifkan mode debug Flask (auto-reload + interactive debugger). HARUS "false"
# di production — debugger Werkzeug bisa dipakai eksekusi kode sembarangan
# kalau server bisa diakses publik.
FLASK_DEBUG=false

# --- MongoDB ---
# Kosongkan/hapus baris di bawah untuk pakai default dev lokal (vicki/123456@localhost).
# MONGO_USERNAME=vicki
# MONGO_PASSWORD=123456
# MONGO_DB_NAME=cmms_db
# MONGO_HOST=localhost
# MONGO_AUTH_DB=admin

# --- CORS ---
# Domain frontend production, dipisah koma kalau lebih dari satu (apex + www).
# Localhost dev (3000/5173) selalu otomatis diizinkan, tidak perlu ditulis di sini.
# Contoh production:
# CORS_EXTRA_ORIGINS=https://cmms-polmanbandung.site,https://www.cmms-polmanbandung.site
